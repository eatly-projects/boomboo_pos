# Contoh isi berkas .env. Yang asli ada di .gitignore dan jangan pernah di-commit.
PORT=4100
NODE_ENV=development
CORS_ORIGIN=http://localhost:5180

# Alamat pooler Supabase. Alamat langsung db.<ref>.supabase.co tidak bisa
# dipakai dari jaringan IPv4. Porta 6543 untuk pooler transaksi.
DATABASE_URL=isi-di-sini

# Skema tempat seluruh tabel aplikasi kasir tinggal. Basis datanya dipakai
# bersama aplikasi Boomboo yang lain, jadi ini yang menjaga supaya tidak
# bertabrakan. Jangan diubah tanpa menjalankan ulang npm run migrate.
DB_SCHEMA=pos

# Alamat basis data yang dipakai SEBELUM pindah, disimpan supaya datanya
# tidak hilang. Sengaja dikomentari: aplikasi tidak pernah membacanya.
# DATABASE_URL_BEFORE=isi-di-sini

SUPABASE_URL=isi-di-sini
SUPABASE_SERVICE_ROLE_KEY=isi-di-sini
SUPABASE_BUCKET=files

JWT_SECRET=isi-di-sini
JWT_EXPIRES_IN=7d
APP_URL=http://localhost:5180
